{
  "name": "mykog-desktop",
  "version": "1.1.0",
  "description": "MyKOG - Application de streaming spirituel pour desktop",
  "main": "main.js",
  "scripts": {
    "start": "electron . --no-sandbox --disable-gpu",
    "dev": "electron . --dev",
    "dist": "electron-builder",
    "build:linux": "electron-builder --linux",
    "build:win": "electron-builder --win",
    "build:mac": "electron-builder --mac"
  },
  "build": {
    "appId": "com.mykog.desktop",
    "productName": "MyKOG",
    "publish": [
      {
        "provider": "generic",
        "url": "https://vps123057.serveur-vps.net/mykog-api/updates/"
      }
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "artifactName": "MyKOG-${version}-${os}-${arch}.${ext}",
    "asar": true,
    "compression": "normal",
    "files": [
      "**/*",
      "!Portfolio/**/*",
      "!dist/**/*",
      "!build/**/*",
      "!node_modules/.cache/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "ia32"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64",
            "ia32"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "ia32"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "signExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "MyKOG",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "artifactName": "MyKOG-Setup-${version}-${arch}.${ext}",
      "installerLanguages": [
        "fr_FR",
        "en_US"
      ],
      "deleteAppDataOnUninstall": false
    },
    "portable": {
      "artifactName": "MyKOG-${version}-portable-${arch}.${ext}"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "category": "Audio",
      "maintainer": "MyKOG <contact@mykog.com>",
      "executableName": "mykog",
      "desktop": {
        "entry": {
          "Name": "MyKOG",
          "Comment": "Application de streaming spirituel",
          "Categories": [
            "Audio",
            "Music",
            "Education"
          ]
        }
      }
    },
    "appImage": {
      "artifactName": "MyKOG-${version}-${arch}.${ext}"
    },
    "deb": {
      "artifactName": "mykog_${version}_${arch}.${ext}",
      "depends": [
        "libgtk-3-0",
        "libnotify4",
        "libnss3",
        "libxss1",
        "libxtst6",
        "xdg-utils",
        "libatspi2.0-0",
        "libuuid1",
        "libsecret-1-0"
      ]
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "category": "public.app-category.music",
      "artifactName": "MyKOG-${version}-${arch}.${ext}"
    },
    "dmg": {
      "artifactName": "MyKOG-${version}-${arch}.${ext}"
    }
  },
  "author": {
    "name": "MyKOG",
    "email": "contact@mykog.com"
  },
  "homepage": "https://mykog.com",
  "license": "MIT",
  "dependencies": {
    "dotenv": "^16.4.0",
    "electron-updater": "^6.3.9",
    "firebase-admin": "^12.0.0",
    "livekit-client": "^2.22.3",
    "pdfjs-dist": "^3.11.174"
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^26.15.3"
  },
  "allowScripts": {
    "electron@33.4.11": true
  }
}
